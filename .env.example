# Public URL of the web app (used in confirmation links)
BASE_URL=https://jobs.example.com
# Shown on the site and used as Reply-To of all emails
CONTACT_EMAIL=contact@example.com
REPO_URL=https://github.com/Kipperlenny/webzap-jobs

# Generate with: python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Generate with: python3 -c "import secrets;print(secrets.token_hex(32))"
HASH_PEPPER=

# SMTP for confirmation emails (e.g. Brevo relay)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=WebZap Jobs <noreply@example.com>

# Legal pages (imprint, privacy policy) are yours, not part of the repository: put privacy.<lang>.html and
# imprint.<lang>.html into private/legal/ (mounted as /legal, see README). If one language is the legally binding
# version, name it here – the other languages then say so and link to it.
# LEGAL_BINDING_LANG=es

# LLM connectors for turning the brainstorm text into search fields (see web/connectors.py).
# Tried in order; empty = tasks wait in the queue. Any OpenAI-compatible server works (LM Studio, Ollama, vLLM, OpenAI).
# Using an external provider (e.g. OpenAI) sends user texts to it: update the privacy policy and get consent first.
LLM_CONNECTORS=lmstudio
LLM_LMSTUDIO_BASE_URL=https://lmstudio.example.com/v1
# LM Studio API token (Developer > Settings > Require API key) – strongly recommended when exposed via a tunnel
LLM_LMSTUDIO_API_KEY=
# Empty = use whatever model LM Studio has loaded
LLM_LMSTUDIO_MODEL=
# Optional extra headers, e.g. a Cloudflare Access service token protecting the tunnel:
# LLM_LMSTUDIO_HEADERS={"CF-Access-Client-Id": "...", "CF-Access-Client-Secret": "..."}
LLM_LMSTUDIO_TIMEOUT=300
# Optional OpenAI connector (not enabled above):
# LLM_OPENAI_API_KEY=
# LLM_OPENAI_MODEL=gpt-5.4-mini

# Partner job search feeds for the digest (each active only when its keys are set). Clicks may earn a fee;
# the digest labels these links as "Partner link".
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# JOOBLE_API_KEY=
# CAREERJET_API_KEY=
# CAREERJET_USER_IP=        # your server's public IP (required by Careerjet for server-side searches)

# Digest: addresses that get their own precision profile instead (comma-separated)
# DIGEST_SKIP_EMAILS=
